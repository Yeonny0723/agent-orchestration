le&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;width:42%;border-bottom:1px solid #d7e0e8&quot;&gt;object_key&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #d7e0e8&quot;&gt;성공 파일 위치 · nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f1f5f9&quot;&gt;&lt;td style=&quot;width:42%;border-bottom:1px solid #d7e0e8&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #d7e0e8&quot;&gt;접수 시각&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;width:42%;border-bottom:1px solid #d7e0e8&quot;&gt;started_at / finished_at&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #d7e0e8&quot;&gt;작업 시각 · nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f1f5f9&quot;&gt;&lt;td style=&quot;width:42%;border-bottom:1px solid #d7e0e8&quot;&gt;expires_at&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #d7e0e8&quot;&gt;성공 후 48시간 · nullable&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td style=&quot;width:42%;border-bottom:1px solid #d7e0e8&quot;&gt;artifact_deleted_at&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #d7e0e8&quot;&gt;파일 삭제 완료 시각 · nullable&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=8;strokeWidth=2;fillColor=#ffffff;strokeColor=#147d78;fontFamily=Malgun Gothic;fontColor=#18324b;rounded=0;spacing=0;align=left;verticalAlign=top;">
