        <mxCell id="note1" value="ReadingGroup 소유권으로 초안·작업 접근 검사. 입력 수정은 이미 접수된 input_snapshot을 바꾸지 않는다." parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;spacing=8;strokeWidth=2;fillColor=#ffffff;strokeColor=#64748b;fontFamily=Malgun Gothic;fontColor=#18324b;text;strokeColor=none;fillColor=none;align=left;fontSize=16;">
